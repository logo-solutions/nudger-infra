apiVersion: apps/v1
kind: Deployment
metadata:
  name: github-runner
spec:
  replicas: 1
  selector:
    matchLabels:
      app: github-runner
  template:
    metadata:
      labels:
        app: github-runner
    spec:
      initContainers:
        - name: runner-setup
          image: ubuntu:20.04
          command:
            - /bin/bash
            - -c
            - |
              echo "🔧 Mise à jour des paquets..."
              apt-get update && apt-get install -y curl sudo
              echo "📥 Téléchargement de l'archive GitHub Runner..."
              curl -o actions-runner-linux-x64.tar.gz -L https://github.com/actions/runner/releases/download/v2.329.0/actions-runner-linux-x64-2.329.0.tar.gz
              echo "📦 Décompression de l'archive..."
              mkdir -p /actions-runner
              tar xzf actions-runner-linux-x64.tar.gz -C /actions-runner
              echo "📂 Vérification du contenu de /actions-runner"
              ls -la /actions-runner
              echo "🛠️ Exécution de config.sh pour l'enregistrement..."
              /actions-runner/config.sh --url https://github.com/logo-solutions/nudger-infra --token $GITHUB_TOKEN
              echo "✅ GitHub Runner configuré avec succès"
          env:
            - name: GITHUB_TOKEN
              valueFrom:
                secretKeyRef:
                  name: github-token
                  key: token
          volumeMounts:
            - name: runner-data
              mountPath: /actions-runner
      containers:
        - name: github-runner
          image: ubuntu:20.04
          command:
            - /bin/bash
            - -c
            - |
              echo "🚀 Démarrage du GitHub Runner..."
              cd /actions-runner && ./run.sh
          volumeMounts:
            - name: runner-data
              mountPath: /actions-runner
      volumes:
        - name: runner-data
          emptyDir: {}
